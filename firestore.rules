rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles: each user can manage their own profile
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Compositions: users can only read and write their own compositions
    match /compositions/{compositionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data) || compositionId in ['comp-1', 'comp-2']);
    }

    // Audio items: user-owned audio records
    match /audioItems/{audioId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    // Key expressions: user-owned vocabulary and key expressions
    match /expressions/{expressionId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || !('userId' in resource.data) || expressionId in ['expr-1', 'expr-2', 'expr-3']);
    }
  }
}
